{"sections":{"1742583019ba8eaf12":{"type":"apps","custom_css":[".header__icons {display: none;}"],"settings":{"full_width":false}},"main":{"type":"main-product","blocks":{"sami_product_labels_app_block_trust_badge_ViAjDK":{"type":"shopify:\/\/apps\/sami-product-labels\/blocks\/app-block-trust-badge\/b9b44663-5d51-4be1-8104-faedd68da8c5","settings":{"shortcode":"<div class=\"samitaPL-trustBadge\" data-id=\"false\"><\/div>"}},"vendor-sku":{"type":"vendor-sku","settings":{"show_vendor":true,"show_sku":true,"show_barcode":true}},"product-labels":{"type":"product-labels","settings":{"show_variant_icon":true}},"title":{"type":"title","settings":{"show_weight":false}},"klaviyo_reviews_average_rating_8ca4JY":{"type":"shopify:\/\/apps\/klaviyo-reviews\/blocks\/average-rating\/db20e365-d984-4ac4-9655-e1588d951ca9","settings":{"product":"{{product}}"}},"sami_product_labels_app_block_highlight_jpWFQF":{"type":"shopify:\/\/apps\/sami-product-labels\/blocks\/app-block-highlight\/b9b44663-5d51-4be1-8104-faedd68da8c5","settings":{"shortcode":"<div class=\"samitaPL-highlight\" data-id=\"false\"><\/div>"}},"variant_picker_KeFyWX":{"type":"variant-picker","settings":{"selector_style":"buttons","enable_dynamic_availability":false,"dynamic_availability_downwards":false,"show_backorder_text":false,"enable_size_chart":false,"size_chart_variant":"Size","size_chart_page":""}},"price":{"type":"price","disabled":true,"settings":{"show_tax_and_shipping":true}},"glo_color_swatch_variant_image_product_bundles_combo_LV67rT":{"type":"shopify:\/\/apps\/globo-color-swatch\/blocks\/product-bundles-combo\/4394f710-096c-4021-bbde-8ebb26057c11","settings":{}},"glo_color_swatch_variant_image_product_groups_detail_CjQz4X":{"type":"shopify:\/\/apps\/globo-color-swatch\/blocks\/product-groups-detail\/4394f710-096c-4021-bbde-8ebb26057c11","settings":{}},"glo_color_swatch_variant_image_product_bundles_quantity_breaks_agQ4by":{"type":"shopify:\/\/apps\/globo-color-swatch\/blocks\/product-bundles-quantity-breaks\/4394f710-096c-4021-bbde-8ebb26057c11","settings":{}},"buy-buttons":{"type":"buy-buttons","settings":{"show_qty_selector":true,"enable_dynamic_checkout":false,"show_pickup_availability":false,"show_gift_card_recipient":false}},"powerful_form_builder_app_block_4x3Mwq":{"type":"shopify:\/\/apps\/powerful-form-builder\/blocks\/app-block\/e4bcb1eb-35b2-42e6-bc37-bfe0e1542c9d","settings":{"shortcode":"<div class=\"globo-formbuilder\" data-id=\"ODY1OTA=\"><\/div>"}},"message-1":{"type":"message","disabled":true,"settings":{"icon":"clock","title":"<p><strong>Popular right now<br\/><\/strong>Lots of people have looked at this recently<\/p>","close":"once","show_over_media":true,"visibility_duration":4,"bg_color":"#e4edfa","text_color":"#1a66d2"}},"message-2":{"type":"message","disabled":true,"settings":{"icon":"price_tag","title":"<p><strong>Selling fast!<br\/><\/strong>Grab yours while you can<\/p>","close":"once","show_over_media":true,"visibility_duration":5,"bg_color":"#e4edfa","text_color":"#1a66d2"}},"collapsible-content-1":{"type":"collapsible-content","disabled":true,"settings":{"heading":"Care information","icon":"heart","text":"<p>Display general product information or specific product information using metafields.<\/p>","page":"","open":false}},"collapsible-content-2":{"type":"collapsible-content","settings":{"heading":"Delivery and Shipping","icon":"truck","text":"<p>Freight is based on your order size, delivery location, or access needs (like lift gates or residential drop-offs).<br\/><br\/>Smaller orders usually ship UPS Ground; heavier orders ship via freight.<br\/><br\/>Need a guaranteed delivery date or a scheduled drop-off? Just let us know in the special instructions during the customization process.<br\/><br\/>Inspect shipments on arrival. If anything is damaged, take photos and notify us within 5 business days.<br\/><br\/>Questions? Contact us at sales@brandmybeverage.com or 888-230-7772.<\/p>","page":"","open":false}},"collapsible_content_PMMP4K":{"type":"collapsible-content","settings":{"heading":"FAQ","icon":"question_mark","text":"<p><strong>How does the ordering process work and is there a proof provided?<\/strong><\/p><p><strong>1. Start with your product.<\/strong><br\/><br\/>Choose the item you want, choose the custom options you want, and enter your delivery details. You’ll be asked how many you need, where you’d like the design printed, how many colors you want printed, and to upload your artwork. Once you’ve added everything, proceed to submit a quote request.<\/p><p><strong>2. Get your order confirmation.<\/strong><br\/><br\/>After checkout, we’ll send you a confirmation email with your order number and an estimated proof date. You can also log in to your account at any time to check your order status under “My Orders.”<\/p><p><strong>3. Review and approve your artwork.<\/strong><br\/><br\/>You’ll receive an email when your digital art proof and order summary are ready to view. Both the artwork and the order details must be approved before we begin production. Please allow up to 3 business days from the time your order is acknowledged for your proof to arrive.<\/p><p><strong>4. We print it and ship it.<\/strong><br\/><br\/>Once your proof is approved, your order goes into production. As soon as it ships, you’ll receive an email with your tracking information.<\/p><p><strong>Need it faster?<\/strong><br\/><br\/>If you’re working on a tight schedule, we may be able to rush your order. Get in touch with our team to discuss timing and shipping options. Additional rush fees may apply depending on the specifics of your project.<\/p><p><strong>How can I see my shipping cost?<\/strong><br\/><br\/>To get a shipping estimate, we need to know your delivery information. Your shipping total will be shown at checkout before you complete your order.<\/p><p><strong>Can I place a reorder?<\/strong><br\/><br\/>Yes! Reordering is easy with Brand My Beverage by contacting us. If you need help, our team is happy to assist.<\/p><p><strong>What types of artwork files can I send?<\/strong><br\/><br\/>The best file types to upload are vector formats such as AI, EPS, or PDF (make sure fonts are outlined and images are embedded). You can also send high-resolution image files like PSD, JPEG, TIFF, or PNG, ideally at 300 to 600 DPI at the actual size. We do not accept CorelDRAW, Word, or PowerPoint files. If you’re unsure whether your file works, upload it anyway and we’ll review it for you.<\/p><p><strong>What’s the deal with California Prop 65?<\/strong><br\/><br\/>Prop 65 is a California law requiring companies to notify customers if a product may expose them to certain chemicals. Some print methods used on glassware may require this labeling. Most of our printing methods are already compliant.<\/p><p>To learn more, visit: <a href=\"https:\/\/oehha.ca.gov\/proposition-65\">https:\/\/oehha.ca.gov\/proposition-65<\/a><\/p>","page":"","open":false}},"share":{"type":"share","settings":{}}},"block_order":["sami_product_labels_app_block_trust_badge_ViAjDK","vendor-sku","product-labels","title","klaviyo_reviews_average_rating_8ca4JY","sami_product_labels_app_block_highlight_jpWFQF","variant_picker_KeFyWX","price","glo_color_swatch_variant_image_product_bundles_combo_LV67rT","glo_color_swatch_variant_image_product_groups_detail_CjQz4X","glo_color_swatch_variant_image_product_bundles_quantity_breaks_agQ4by","buy-buttons","powerful_form_builder_app_block_4x3Mwq","message-1","message-2","collapsible-content-1","collapsible-content-2","collapsible_content_PMMP4K","share"],"custom_css":[".btn--primary,.spr-button-primary,.shopify-payment-button .shopify-payment-button__button--unbranded,.shopify-challenge__button {display: none;}",".product-info__add-to-cart {display: flex; flex-direction: column;}",".product-info__add-to-cart quantity-input {flex-basis: 50px;}",".lowest-price {color: red; font-weight: bold;}"],"settings":{"stick_on_scroll":true,"select_first_variant":false,"sticky_atc_panel":false,