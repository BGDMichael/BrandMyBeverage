tion-3":{"type":"collection","settings":{"collection":"shot-and-taster-glasses"}},"collection-list-collection-4":{"type":"collection","settings":{"collection":"glass-mugs"}},"collection_cHiifb":{"type":"collection","settings":{"collection":"glass-flutes"}},"collection-list-collection-5":{"type":"collection","settings":{"collection":"ceramic-mug"}},"collection-list-collection-6":{"type":"collection","settings":{"collection":"oktoberfest"}}},"block_order":["collection-list-collection-1","collection-list-collection-2","collection-list-collection-3","collection-list-collection-4","collection_cHiifb","collection-list-collection-5","collection-list-collection-6"],"settings":{"title":"Our Collections","heading_align":"text-start","button_label":"","button_link":"","layout":"carousel","card_size":"small","use_product_image":false,"circle_image":true,"show_border":true,"color_scheme":"none","full_width":true}},"image-banner":{"type":"image-banner","blocks":{"image-banner-heading":{"type":"heading","settings":{"heading":"Image banner","heading_size":"h1","heading_h1":false}},"image-banner-text":{"type":"text","settings":{"text":"<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.<\/p>","enlarge_text":true}},"image-banner-button":{"type":"button","settings":{"button_1_label":"Optional button","button_1_link":"","button_1_style":"btn btn--primary","button_2_label":"Optional button","button_2_link":"","button_2_style":"btn btn--primary"}}},"block_order":["image-banner-heading","image-banner-text","image-banner-button"],"disabled":true,"settings":{"url":"","height_mode":"fixed","fixed_height_desktop":640,"fixed_height_mobile":480,"overlay_position":"justify-center items-center","overlay_text_align":"text-center","mob_center_text":false,"mobile_stacked":false,"color_scheme":"white","full_width":false,"transparent_content_color":"#ffffff","tint_color":"#000000","tint_opacity":40,"prevent_animation":false}},"custom_liquid_BypVhx":{"type":"custom-liquid","name":"Quantity Choice Limiter","settings":{"custom_liquid":"<script>\n(function () {\n  let lastMOQ = null; \/\/ remember last applied value\n\n  function parseMOQ() {\n    const cell =\n      document.querySelector('#samitaWS-volumeDisplayTableForm-id-19402 table tbody td') ||\n      document.querySelector('[id^=\"samitaWS-volumeDisplayTableForm-id-\"] table tbody td');\n    if (!cell) return null;\n    const m = cell.textContent.match(\/\\d+\/);\n    return m ? parseInt(m[0], 10) : null;\n  }\n\n  function getQtyInput() {\n    return document.querySelector('input.qty-input__input[name=\"quantity\"]')\n        || document.querySelector('input[name=\"quantity\"]');\n  }\n\n  function applyMOQ(minQty) {\n    const input = getQtyInput();\n    if (!input || !minQty) return;\n\n    \/\/ Always set the MIN so the +\/- buttons know the floor\n    input.setAttribute('min', String(minQty));\n\n    \/\/ Only set the value if it's empty or below min, so users can increase freely\n    const current = Number(input.value || 0);\n    if (!input.value || !Number.isFinite(current) || current < minQty) {\n      input.value = String(minQty);\n      input.dispatchEvent(new Event('input', { bubbles: true }));\n      input.dispatchEvent(new Event('change', { bubbles: true }));\n    }\n  }\n\n  function updateIfChanged() {\n    const moq = parseMOQ();\n    if (!moq) return;\n\n    \/\/ Only re-apply when MOQ actually changes (e.g., different variant)\n    if (moq !== lastMOQ) {\n      lastMOQ = moq;\n      applyMOQ(moq);\n    }\n  }\n\n  \/\/ Initial run (after DOM ready)\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', updateIfChanged);\n  } else {\n    updateIfChanged();\n  }\n\n  \/\/ Observe but throttle so we don't fight the user\n  let rafScheduled = false;\n  const obs = new MutationObserver(() => {\n    if (rafScheduled) return;\n    rafScheduled = true;\n    requestAnimationFrame(() => {\n      rafScheduled = false;\n      updateIfChanged();\n    });\n  });\n  obs.observe(document.documentElement, { childList: true, subtree: true });\n\n  \/\/ Re-check on variant change only (don’t force value if user already set higher)\n  document.addEventListener('change', (e) => {\n    const t = e.target;\n    if (t && (t.matches('select[name=\"id\"]') || t.matches('input[name=\"id\"][type=\"radio\"]'))) {\n      \/\/ Give the app a tick to swap the pricing table, then re-read MOQ\n      setTimeout(updateIfChanged, 0);\n    }\n  });\n})();\n<\/script>","section_height":"default","full_width":false,"dividers":"none","prevent_animation":false}},"custom_liquid_tkAcHQ":{"type":"custom-liquid","custom_css":[],"name":"Calculated Estimated Price","settings":{"custom_liquid":"<script>\n(function(){\n  var TABLE_SELECTORS = [\n    '#samitaWS-volumeDisplayTableForm-id-19402 table',\n    '[id^=\"samitaWS-volumeDisplayTableForm-id-\"] table',\n    '[id*=\"volumeDisplayTableForm\"] table'\n  ];\n  var QTY_SELECTORS = [\n    'input.qty-input__input[name=\"quantity\"]',\n    'quantity-input input[name=\"quantity\"]',\n    'input[name=\"quantity\"]'\n  ];\n  var ADD_TO_CART_SEL = 'form[action*=\"\/cart\/add\"] [type=\"submit\"], form[action*=\"\/cart\/add\"] button[name=\"add\"]';\n  var tiers = [], currency = '$', parsed = false;\n\n  function $(s, r){ return (r||document).querySelector(s); }\n  function findFirst(selectors){ for (var i=0;i<selectors.length;i++){ var el=$(selectors[i]); if(el) return el; } return null; }\n  function num(txt){\n    if (!txt) return NaN;\n    var t = txt.replace(\/[^0-9.,]\/g,'').trim();\n    if (!t) return NaN;\n    var d = t.lastIndexOf('.'), c = t.lastIndexOf(',');\n    var n = (c>d) ? t.replace(\/\\.\/g,'').replace(',', '.') : t.replace(\/,\/g,'');\n    return parseFloat(n);\n  }\n  function money(v){\n    try { if (window?.Shopify?.formatMoney) return Shopify.formatMoney(Math.round(v*100)); } catch(e){}\n    return (currency||'$') + new Intl.NumberFormat(undefined,{minimumFractionDigits:2,maximumFractionDigits:2}).format(v);\n  }\n  function findTable(){\n    for (var i=0;i<TABLE_SELECTORS.length;i++){ var t=$(TABLE_SELECTORS[i]); if(t) return t; }\n    return null;\n  }\n  function parseTiers(){\n    var table = findTable();\n    if (!table) return false;\n    var rows = table.querySelectorAll('tbody tr');\n    var out = [], cur = currency;\n    rows.forEach(function(tr){\n      var tds = tr.querySelectorAll('td');\n      if (tds.length < 2) return;\n      var m = (tds[0].textContent||'').match(\/\\d+\/);\n      var minQty = m ? parseInt(m[0],10) : NaN;\n      var priceTxt = tds[1].textContent||'';\n      var unit = num(priceTxt);\n      var sym = (priceTxt.match(\/[^0-9.,\\s]\/)||[])[0];\n      if (sym) cur = sym;\n      if (Number.isFinite(minQty) && Number.isFinite(unit)) out.push({minQty, unit});\n    });\n    out.sort(function(a,b){ return a.minQty - b.minQty; });\n    if (!out.length) return false;\n    tiers = out; currency = cur || currency; parsed = true; return true;\n  }\n  function activeTier(q){\n    if (!tiers.length) return null;\n    var chosen = tiers[0];\n    for (var i=0;i<tiers.length;i++){ if (q >= tiers[i].minQty) chosen = tiers[i]; else break; }\n    return chosen;\n  }\n  function createUI(){\n    var wrap = document.createElement('div');\n    wrap.className = 'pe-inline';\n    wrap.style.cssText = 'margin-top:.75rem;padding:.6rem .75rem;font:inherit;font-size:12pt;display:flex;flex-direction:column;gap:.4rem;background:#f9f9f9;border-radius:.4rem';\n    \n    \/\/ Title\n    var title = document.createElement('div');\n    title.textContent = 'Estimated Cost';\n    title.style.fontWeight = '600';\n    title.style.marginBottom = '.1rem';\n    wrap.appendChild(title);\n\n    \/\/ Subhead \/ caption\n    var caption = document.createElement('div');\n    caption.textContent = 'Setup and shipping fees, as well as adding colors or other decoration methods for your order will increase this cost. Actual price will be reflected in the quote you will receive.';\n    caption.style.fontSize = '0.85em';\n    caption.style.opacity = '0.75';\n    caption.style.lineHeight = '1.3';\n    wrap.appendChild(caption);\n    \n    \/\/ Row\n    var row = document.createElement('div');\n    row.style.display = 'flex';\n    row.style.flexWrap = 'wrap';\n    row.style.gap = '.5rem';\n    row.innerHTML =\n      '<span style=\"opacity:.7;margin-right:.25rem\">Unit:<\/span><span class=\"peu\">—<\/span>' +\n      '<span style=\"opacity:.4\">|<\/span>' +\n      '<span style=\"opacity:.7;margin-right:.25rem\">Qty:<\/span><span class=\"peq\">—<\/span>' +\n      '<span style=\"opacity:.4\">|<\/span>' +\n      '<span style=\"opacity:.7;margin-right:.25rem\">Total:<\/span><span class=\"pet\">—<\/span>';\n    wrap.appendChild(row);\n\n    wrap.hidden = true;\n    return wrap;\n  }\n  function render(wrap, qtyInput){\n    if (!parsed) return;\n    var unitEl = wrap.querySelector('.peu'), qtyEl = wrap.querySelector('.peq'), totEl = wrap.querySelector('.pet');\n    var q = parseInt(qtyInput.value,10);\n    if (!Number.isFinite(q) || q < 1) q = tiers[0].minQty || 1;\n    var tier = activeTier(q) || tiers[0];\n    unitEl.textContent = money(tier.unit);\n    qtyEl.textContent = String(q);\n    totEl.textContent = money(q * tier.unit);\n    wrap.hidden = false;\n  }\n  function boot(){\n    var qtyInput = findFirst(QTY_SELECTORS);\n    var atcBtn = $(ADD_TO_CART_SEL);\n    if (!qtyInput || !atcBtn) return setTimeout(boot, 200);\n    var wrap = createUI();\n    atcBtn.parentNode.insertBefore(wrap, atcBtn.nextSibling);\n    if (!parseTiers()){\n      var container = findTable()?.closest('[id]') || document.body;\n      var mo = new MutationObserver(function(){\n        if (parseTiers()){ mo.disconnect(); render(wrap, qtyInput); }\n      });\n      mo.observe(container, { childList:true, subtree:true });\n    } else {\n      render(wrap, qtyInput);\n    }\n    qtyInput.addEventListener('input', function(){ render(wrap, qtyInput); });\n    qtyInput.addEventListener('change', function(){ render(wrap, qtyInput); });\n    document.addEventListener('change', function(e){\n      if (e.target && (e.target.matches('select[name=\"id\"]') || e.target.matches('input[name=\"id\"][type=\"radio\"]'))) {\n        parsed = false; tiers = [];\n        setTimeout(function(){ if (parseTiers()) render(wrap, qtyInput); }, 0);\n      }\n    });\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n})();\n<\/script>","section_height":"default","full_width":false,"dividers":"none","prevent_animation":false}}},"order":["1742583019ba8eaf12","main","details","17452617475410942f","1744318032c71238fa","product-features","recommendations","product-comparison-grid","17431701071b45372d","17425829555d9cb548","collection-list","image-banner","custom_liquid_BypVhx","custom_liquid_tkAcHQ"]}