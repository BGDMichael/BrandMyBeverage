<script>
document.addEventListener("DOMContentLoaded", function() {
  const editBtn = document.querySelector(".edit-order");
  if (!editBtn) return;

  editBtn.addEventListener("click", function() {
    const metafields = {
      number_of_colors: "{{ order.metafields.custom.number_of_colors | escape }}",
      color_names: "{{ order.metafields.custom.color_names | escape }}",
      imprint_location: "{{ order.metafields.custom.imprint_location | escape }}",
      artwork: "{{ order.metafields.custom.artwork | escape }}",
      special_instructions: "{{ order.metafields.custom.special_instructions | escape }}",
      due_date: "{{ order.metafields.custom.due_date | escape }}",
      product_url: "{{ order.line_items.first.product.url }}"
    };

    // Save only non-empty values
    Object.keys(metafields).forEach(key => {
      if (metafields[key] && metafields[key] !== '') {
        sessionStorage.setItem(key, metafields[key]);
      }
    });

    // Redirect
    if (metafields.product_url) {
      window.location.href = metafields.product_url;
    }
  });
});
</script>
